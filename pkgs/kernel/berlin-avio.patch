diff -Naur a/arch/arm/mach-berlin/berlin.c b/arch/arm/mach-berlin/berlin.c
--- a/arch/arm/mach-berlin/berlin.c	2026-11-04 15:48:26.750479706 +0000
+++ b/arch/arm/mach-berlin/berlin.c	2026-11-04 15:48:34.530629343 +0000
@@ -9,14 +9,40 @@
  */
 
 #include <asm/mach/arch.h>
+#include <asm/mach/map.h>
 
 static const char * const berlin_dt_compat[] = {
 	"marvell,berlin",
 	NULL,
 };
 
+/*
+ * Marvell's AVIO drivers (galois_pe and its dhub HAL, from the vendor 3.8 kernel)
+ * dereference register addresses directly. Map the register window 1:1, as the vendor
+ * kernel did; it lies in the vmalloc area, which keeps static mappings out of its way.
+ */
+static struct map_desc berlin_io_desc[] __initdata = {
+	{
+		.virtual	= 0xf7000000,
+		.pfn		= __phys_to_pfn(0xf7000000),
+		.length		= 0x00cc0000,
+		.type		= MT_DEVICE,
+	}, {
+		.virtual	= 0xf7cd0000,
+		.pfn		= __phys_to_pfn(0xf7cd0000),
+		.length		= 0x00330000,
+		.type		= MT_DEVICE,
+	},
+};
+
+static void __init berlin_map_io(void)
+{
+	iotable_init(berlin_io_desc, ARRAY_SIZE(berlin_io_desc));
+}
+
 DT_MACHINE_START(BERLIN_DT, "Marvell Berlin")
 	.dt_compat	= berlin_dt_compat,
+	.map_io		= berlin_map_io,
